[Unit]
Description=MingDao TCM Site (明道中医 · 问诊台 内部站点)
Documentation=https://tcm.mingdao.ai/
After=network.target

[Service]
# 与官网的 mingdao-bbs.service 同一路子：宿主 node 直接跑单文件服务，只监听回环，
# 由 openresty 容器（host 网络）反代到 127.0.0.1:8448。
ExecStart=/usr/local/bin/node /opt/mingdao/tcm-site-server.js
Environment=TCM_PORT=8448 TCM_ROOT=/opt/1panel/www/sites/tcm-site TCM_DATA=/var/lib/mingdao-tcm-site
# TCM_PUBLIC=1 → 公开站点（首页/安装包清单/下载都免登录）；注释掉即回到"需要访问密码"。
# 后台 /admin 两种模式下都要管理员密码。
Environment=TCM_PUBLIC=1
Restart=always
RestartSec=3

# 它只做「密码门 + 发文件」，不需要任何特权
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/mingdao-tcm-site

[Install]
WantedBy=multi-user.target
